# Variáveis de ambiente do CalcSISTEC — copie para `.env` e preencha.
# O `.env` é ignorado pelo Git; este exemplo não carrega segredo nenhum.
# O script `scripts/testar.ps1` lê ADMIN_EMAIL, ADMIN_SENHA e FLASK_SECRET_KEY
# do `.env` e cria o arquivo na primeira execução, se ele não existir.

# E-mail do administrador; é a metade do par que libera o login (app/auth.py).
ADMIN_EMAIL=
# Hash (nunca a senha em texto puro) da senha do administrador (app/auth.py).
# Gere com: python -c "from werkzeug.security import generate_password_hash as g; print(g('SUA_SENHA'))"
ADMIN_PASSWORD_HASH=
# Chave que assina o cookie de sessão Flask (app/app.py). Em branco, o app
# sorteia uma por processo e derruba as sessões abertas a cada reinício.
FLASK_SECRET_KEY=
# "1" liga SESSION_COOKIE_SECURE e exige HTTPS fora de localhost (app/config.py).
CALCSISTEC_HTTPS=
# Endereço do Sistec lido pelo servidor (app/sistec/urls.py). É por aqui que o
# ambiente de teste aponta para scripts/sistec_simulado.py, na porta 8051.
CALCSISTEC_SISTEC_BASE_URL=https://sistec.mec.gov.br
# Pasta de downloads do navegador que o app vigia (app/sistec/downloads.py).
# Em branco, ele descobre a pasta padrão do usuário no Windows.
CALCSISTEC_PASTA_DOWNLOADS=
# Pasta fixa de trabalho do CalcSISTEC (app/sistec/downloads.py). Em branco,
# ele usa %LOCALAPPDATA%\CalcSISTEC\coleta (ou ~/.local/share no Linux).
CALCSISTEC_PASTA_COLETA=
# Ano-base dos indicadores quando não há ano publicado (app/app.py).
ANO_BASE=2026
